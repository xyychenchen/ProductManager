<?xml version="1.0" encoding="utf-8"?>
<!-- 产品条目：只保留产品内容，分组头已拆分到 item_letter_header.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/item_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_product_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 产品照片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/photo_placeholder_bg"
                android:contentDescription="@string/product_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_product" />

        </androidx.cardview.widget.CardView>

        <!-- 产品信息 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Product Name" />

            <TextView
                android:id="@+id/tv_specification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="规格: Large"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="尺寸: 10x20cm"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="材质: 纯棉"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="备注: 这是备注内容"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- 价格 -->
        <TextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:textColor="@color/price"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="$99.99" />

    </LinearLayout>

    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="88dp"
        android:background="@color/divider" />

</LinearLayout>

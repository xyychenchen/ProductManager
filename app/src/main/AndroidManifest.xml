<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        不再声明存储与相机权限：
        - 选图走系统文件选择器（ACTION_GET_CONTENT），由系统授予临时读取权限
        - 拍照调用系统相机（TakePicture），未声明 CAMERA 时无需运行时授权
        - 图片只写入应用私有目录，无需外部存储权限
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProductManager"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ProductManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddProductActivity"
            android:exported="false"
            android:label="@string/add_product"
            android:theme="@style/Theme.ProductManager" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:theme="@style/Theme.ProductManager" />

        <activity
            android:name=".ScriptViewerActivity"
            android:exported="false"
            android:label="话术查看"
            android:theme="@style/Theme.ProductManager" />

        <!-- FileProvider 用于拍照临时文件共享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.productmanager.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
